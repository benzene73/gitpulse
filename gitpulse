def main():
    repos = find_repos()
    if not repos:
        print("gitpulse: no repos found. Edit REPOS at the top of this file.",
              file=sys.stderr)
        sys.exit(1)
    quiet = "--quiet" in sys.argv
    if "--fetch" in sys.argv:
        fetch_repos(repos, quiet)
    emails = author_emails(repos)
    since = date.today() - timedelta(days=DAYS + 2)
    commits = collect(repos, emails, since)
    html = render(commits, repos)
    with open(OUT, "w") as f:
        f.write(html)
    if not quiet:
        print(f"gitpulse: {len(commits)} commits across {len(repos)} repos -> {OUT}")
    if not quiet and "--no-open" not in sys.argv:
        subprocess.run(["open", OUT])


if __name__ == "__main__":
    main()
