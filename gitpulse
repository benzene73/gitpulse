def main():
    repos = find_repos()
    if not repos:
        print("gitpulse: no repos found. Edit REPOS at the top of this file.",
              file=sys.stderr)
        sys.exit(1)
    quiet = "--quiet" in sys.argv
    should_fetch = "--no-fetch" not in sys.argv and not quiet
    if should_fetch or "--fetch" in sys.argv:
        fetch_repos(repos, quiet)
    emails = author_emails(repos)
    since = date.today() - timedelta(days=HISTORY_DAYS + 2)
    commits = collect(repos, emails, since)
    html = render(commits, repos)
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(html)
    if not quiet:
        print(
            f"gitpulse: analyzed {len(commits)} commits across {len(repos)} repos "
            f"({HISTORY_DAYS} days) -> {OUT}"
        )
    if not quiet and "--no-open" not in sys.argv:
        if os.name == "nt":
            os.startfile(OUT)
        else:
            subprocess.run(["open", OUT])


if __name__ == "__main__":
    main()
