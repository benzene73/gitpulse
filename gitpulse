#!/usr/bin/env python3
"""
gitpulse — a local, self-contained picture of when you actually shipped.

Scans your repos, reads git log, writes one standalone HTML file.
No server or dependencies. Network access is opt-in. Open it with a double click.

  gitpulse            regenerate and open the page
  gitpulse --fetch    fetch remotes, regenerate, and open
  gitpulse --no-open  regenerate without opening
"""

import os
import subprocess
import sys
from datetime import datetime, timedelta, date

