# ---------------------------------------------------------------- git


def find_repos():
    return [repo for repo in REPOS
            if os.path.exists(os.path.join(repo, ".git"))]


def git(repo, *args):
    try:
        out = subprocess.run(["git", "-C", repo, *args],
                             capture_output=True, text=True, timeout=20)
        return out.stdout if out.returncode == 0 else ""
    except Exception:
        return ""


def fetch_repos(repos, quiet):
    for repo in repos:
        name = os.path.basename(repo)
        if not quiet:
            print(f"gitpulse: fetching {name}...")
        try:
            result = subprocess.run(
                ["git", "-C", repo, "fetch", "--all", "--prune"],
                capture_output=True, text=True, timeout=120
            )
            if result.returncode != 0:
                detail = result.stderr.strip() or result.stdout.strip()
                print(f"gitpulse: failed to fetch {name}: {detail}",
                      file=sys.stderr)
        except (OSError, subprocess.TimeoutExpired) as error:
            print(f"gitpulse: failed to fetch {name}: {error}",
                  file=sys.stderr)


def author_emails(repos):
    if AUTHOR_EMAILS:
        return {e.lower() for e in AUTHOR_EMAILS}
    emails = set()
    for r in repos:
        e = git(r, "config", "user.email").strip()
        if e:
            emails.add(e.lower())
    globl = subprocess.run(["git", "config", "--global", "user.email"],
                           capture_output=True, text=True).stdout.strip()
    if globl:
        emails.add(globl.lower())
    return emails


def collect(repos, emails, since):
    commits = []
    # \x1e record marker, then time/sha/email/subject; --numstat lines follow.
    fmt = "\x1e%ad\x1f%h\x1f%ae\x1f%s"
    for repo in repos:
        name = os.path.basename(repo)
        raw = git(repo, "log", "--all", "--no-merges", "--numstat",
                  f"--since={since.isoformat()}",
                  "--date=format:%Y-%m-%d %H:%M",
                  f"--pretty=format:{fmt}", "--", ".", *EXCLUDE)
        cur = None
        for line in raw.split("\n"):
            if line.startswith("\x1e"):
                parts = line[1:].split("\x1f")
                cur = None
                if len(parts) != 4:
                    continue
                when, sha, email, subject = parts
                if emails and email.lower() not in emails:
                    continue
                try:
                    ts = datetime.strptime(when, "%Y-%m-%d %H:%M")
                except ValueError:
                    continue
                cur = {"ts": ts, "sha": sha, "repo": name,
                       "subject": subject, "adds": 0, "dels": 0}
                commits.append(cur)
            elif cur is not None and "\t" in line:
                a, d, _ = (line.split("\t", 2) + ["", "", ""])[:3]
                # binary files show as '-'; count them as 0 lines
                cur["adds"] += int(a) if a.isdigit() else 0
                cur["dels"] += int(d) if d.isdigit() else 0
    # same commit can appear in several worktrees/clones
    seen, unique = set(), []
    for c in sorted(commits, key=lambda c: c["ts"]):
        key = (c["sha"], c["repo"])
        if key in seen:
            continue
        seen.add(key)
        unique.append(c)
    return unique

# ---------------------------------------------------------------- colour


# hour of day -> colour. Synthwave rotation: cyan night -> magenta noon ->
# sunset orange -> neon purple. Every tick is a light source.
RAMP = [
    (0.0,  (0x00, 0xE5, 0xFF)),
    (5.0,  (0x2B, 0x6B, 0xFF)),
    (8.0,  (0x7B, 0x3F, 0xF2)),
    (12.5, (0xFF, 0x2D, 0x95)),
    (17.0, (0xFF, 0x6A, 0x3D)),
    (21.0, (0xB1, 0x4D, 0xFF)),
    (24.0, (0x00, 0xE5, 0xFF)),
]


def hour_color(h):
    for i in range(len(RAMP) - 1):
        h0, c0 = RAMP[i]
        h1, c1 = RAMP[i + 1]
        if h0 <= h <= h1:
            t = 0 if h1 == h0 else (h - h0) / (h1 - h0)
            rgb = tuple(round(a + (b - a) * t) for a, b in zip(c0, c1))
            return "#%02x%02x%02x" % rgb
    return "#00e5ff"

# ---------------------------------------------------------------- stats


def streak(days_with_commits, today):
    if not days_with_commits:
        return 0
    cursor = today if today in days_with_commits else today - timedelta(days=1)
    n = 0
    while cursor in days_with_commits:
        n += 1
        cursor -= timedelta(days=1)
    return n


def longest_streak(days_with_commits):
    longest = current = 0
    previous = None
    for active_day in sorted(days_with_commits):
        current = current + 1 if previous == active_day - timedelta(days=1) else 1
        longest = max(longest, current)
        previous = active_day
    return longest


def three_day_output(commits, today):
    current_start = today - timedelta(days=2)

    def additions_between(start, finish):
        return sum(
            commit["adds"]
            for commit in commits
            if start <= commit["ts"].date() <= finish
        )

    current = additions_between(current_start, today)
    previous_six_days = additions_between(
        current_start - timedelta(days=6),
        current_start - timedelta(days=1)
    )
    target = max(1, round(previous_six_days / 2))
    return current, target


def esc(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))


def human(n):
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M".replace(".0M", "M")
    if n >= 1_000:
        return f"{n/1_000:.1f}k".replace(".0k", "k")
    return str(n)

# ---------------------------------------------------------------- render


def render(commits, repos):
    today = date.today()
    now = datetime.now()
    history_days = [
        today - timedelta(days=i)
        for i in range(HISTORY_DAYS - 1, -1, -1)
    ]
    history_by_day = {d: [] for d in history_days}
    for commit in commits:
        commit_day = commit["ts"].date()
        if commit_day in history_by_day:
            history_by_day[commit_day].append(commit)

    days = history_days[-DAYS:]
    by_day = {d: history_by_day[d] for d in days}
    active = {d for d, day_commits in history_by_day.items() if day_commits}
    run = streak(active, today)
    best_run = longest_streak(active)
    three_day_additions, three_day_goal = three_day_output(commits, today)
    todays = sorted(history_by_day[today], key=lambda c: c["ts"])

    def churn(day_commits):
        return sum(c["adds"] + c["dels"] for c in day_commits)

    def adds(day_commits):
        return sum(c["adds"] for c in day_commits)

    def dels(day_commits):
        return sum(c["dels"] for c in day_commits)

    all_commits = [c for day_commits in by_day.values() for c in day_commits]
    total_add = adds(all_commits)
    today_add, today_del = adds(todays), dels(todays)
    max_churn = max((c["adds"] + c["dels"] for c in all_commits), default=0)

    # ---- the strip
    peak = max((churn(cs) for cs in by_day.values()), default=0)
    now_frac = (now.hour + now.minute / 60) / 24 * 100
    cols = []
    for idx, d in enumerate(days):
        cs = by_day[d]
        is_today = d == today
        ticks = []
        for c in cs:
            h = c["ts"].hour + c["ts"].minute / 60
            top = h / 24 * 100
            col = hour_color(h)
            # thickness = weight of the commit (log-scaled lines changed)
            ch = c["adds"] + c["dels"]
            import math
            frac = (math.log10(1 + ch) / math.log10(1 + max_churn)) if max_churn > 1 else 0.0
            hpx = 3 + round(37 * frac)              # 3px trivial -> 40px monster
            blur = 6 + round(18 * frac)
            ticks.append(
                f'<i style="top:{top:.2f}%;height:{hpx}px;background:{col};'
                f'box-shadow:0 0 {blur//3}px {col},0 0 {blur}px {col}cc,0 0 {blur*2}px {col}66" '
                f'title="{esc(c["ts"].strftime("%H:%M"))} · {esc(c["repo"])} · '
                f'+{c["adds"]} −{c["dels"]} · {esc(c["subject"])}"></i>')
        # heat: heavier days (more lines) glow brighter from behind the tube
        heat = 0 if peak == 0 else min(1.0, churn(cs) / max(peak, 1))
        weekend = " we" if d.weekday() >= 5 else ""
        klass = "col" + weekend + (" today" if is_today else "")
        dot = "on" if cs else "off"
        label = ""
        if d.day == 1 or idx == 0:
            label = d.strftime("%b").lower()
        # live now-line marker only on today's still-open column
        nowline = (f'<b class="now" style="top:{now_frac:.2f}%"></b>'
                   if is_today else "")
        # gap days get a red glitch scar instead of an empty tube
        scar = "" if cs else '<u class="scar"></u>'
        cols.append(
            f'<div class="{klass}" style="--i:{idx};--heat:{heat:.2f}">'
            f'<div class="tube">{scar}{"".join(ticks)}{nowline}</div>'
            f'<div class="dot {dot}" title="{d.isoformat()} · {len(cs)} commits · '
            f'+{adds(cs)} −{dels(cs)}"></div>'
            f'<div class="dlab">{label}</div>'
            f'</div>')

    # ---- today's log and receipt
    if todays:
        tmax = max((c["adds"] + c["dels"] for c in todays), default=1) or 1

        def row(c):
            w = (c["adds"] + c["dels"]) / tmax * 100
            col = hour_color(c["ts"].hour + c["ts"].minute / 60)
            return (
                f'<li><span class="t" style="color:{col}">'
                f'{c["ts"].strftime("%H:%M")}</span>'
                f'<span class="r">{esc(c["repo"])}</span>'
                f'<span class="ch"><span class="add">+{c["adds"]}</span>'
                f'<span class="del">−{c["dels"]}</span></span>'
                f'<span class="bar"><i style="width:{w:.1f}%;background:{col};'
                f'box-shadow:0 0 8px {col}"></i></span>'
                f'<span class="s">{esc(c["subject"])}</span></li>')

        rows = "".join(row(c) for c in todays)
        span = (f'{todays[0]["ts"].strftime("%H:%M")}–'
                f'{todays[-1]["ts"].strftime("%H:%M")}')
        today_val = f'+{human(today_add)}'
        repo_count = len({c["repo"] for c in todays})
        receipt_state = "NIGHT RECEIPT" if now.hour >= 20 else "LIVE FEED"
        receipt_meta = (
            f'{len(todays)} commits · {repo_count} repos · {span} · '
            f'−{human(today_del)} lines'
        )
    else:
        rows = '<li class="empty">No transmission yet. Today is still writable.</li>'
        today_val = "—"
        receipt_state = "OPEN SLOT"
        receipt_meta = "zero commits · the day is still live"

    # ---- streak pressure
    best_run = max(best_run, run)
    if todays:
        streak_class = "locked"
        streak_badge = ""
    elif run:
        midnight = datetime.combine(today + timedelta(days=1), datetime.min.time())
        seconds_left = max(0, int((midnight - now).total_seconds()))
        hours_left, remainder = divmod(seconds_left, 3600)
        minutes_left = remainder // 60
        streak_class = "risk"
        streak_badge = f"AT RISK · {hours_left:02d}h {minutes_left:02d}m left"
    else:
        streak_class = "reboot"
        streak_badge = ""
    badge_html = f"<b>{streak_badge}</b>" if streak_badge else ""
    record_progress = min(100, run / max(best_run, 1) * 100)
    streak_console = (
        f'<div class="streak-console {streak_class}">'
        f'<div class="console-top"><span>STREAK</span>{badge_html}</div>'
        f'<div class="run"><strong>{run:02d}</strong><span>days</span></div>'
        f'<div class="record"><span>{HISTORY_DAYS}D BEST</span>'
        f'<b>{best_run:02d} DAYS</b></div>'
        f'<div class="record-track"><i style="width:{record_progress:.1f}%"></i></div>'
        f'</div>'
    )

    # ---- adaptive three-day output
    goal_remaining = max(0, three_day_goal - three_day_additions)
    goal_state = "GOAL CLEARED" if goal_remaining == 0 else f"+{human(goal_remaining)} TO GO"
    goal_progress = min(100, three_day_additions / max(three_day_goal, 1) * 100)
    mission_card = (
        f'<div class="mission-card"><div class="card-top">'
        f'<span>3-DAY OUTPUT</span><b>{goal_state}</b></div>'
        f'<div class="mission-score"><strong>+{human(three_day_additions)}</strong>'
        f'<span>/ +{human(three_day_goal)} target</span></div>'
        f'<div class="output-track"><i style="width:{goal_progress:.1f}%"></i></div>'
        f'<div class="card-foot">target · prior 6 days ÷ 2</div></div>'
    )
    receipt_card = (
        f'<div class="receipt-card"><div class="card-top">'
        f'<span>TODAY // RECEIPT</span><b>{receipt_state}</b></div>'
        f'<div class="receipt-score">{esc(today_val)}</div>'
        f'<div class="receipt-meta">{esc(receipt_meta)}</div></div>'
    )

    # hero: the sheer weight — total lines shipped over the visible window
    head_num = human(total_add)
    head_lab = f"lines shipped · {DAYS} days"

    stamp = datetime.now().strftime("%a %d %b %Y · %H:%M")
    repo_line = " · ".join(sorted({os.path.basename(r) for r in repos})[:8])

    return f"""<!doctype html>
